# =====================================================================
#  LinkForge configuration  ->  copy to `.env` and edit
# =====================================================================

# ---- Neo4j (THE ONLY THING YOU MUST CHANGE TO GET STARTED) ----------
# Neo4j AuraDB Free:  neo4j+s://<instance-id>.databases.neo4j.io
# Local Docker:       bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# ---- LLM for triplet extraction + Graph-RAG chat ---------------------
# Primary provider: "groq" (free API key from console.groq.com) or "ollama" (local)
LLM_PROVIDER=groq
# Optional fallback used automatically if the primary fails ("" to disable)
LLM_FALLBACK_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Seconds to wait between LLM calls (keeps you inside Groq free-tier limits)
LLM_MIN_INTERVAL_SEC=2.5

# ---- Embeddings (local, free) ----------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Data acquisition ------------------------------------------------
# Contact e-mail is sent to NCBI / Unpaywall-style APIs (polite-pool etiquette)
CONTACT_EMAIL=you@example.com
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# ---- Entity resolution / extraction tuning ---------------------------
ENTITY_MERGE_THRESHOLD=0.85
ENTITY_ALPHA=0.7
MIN_TRIPLET_CONFIDENCE=0.5
MAX_CHUNKS_PER_PAPER=30

# ---- Background auto-scraper (APScheduler) ---------------------------
AUTO_SCRAPE_ENABLED=false
AUTO_SCRAPE_QUERIES=neuroinflammation flavanols;curcumin alzheimer
AUTO_SCRAPE_SOURCE=europe_pmc
AUTO_SCRAPE_LIMIT=10
AUTO_SCRAPE_INTERVAL_HOURS=24

# ---- API server ------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---- Optional: Cloudflare R2 mirror for PDFs (S3-compatible) ---------
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
PDF_PARSER=pymupdf

# ---- Security (set BOTH before deploying publicly) -------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
RATE_LIMIT_PER_MIN=30
